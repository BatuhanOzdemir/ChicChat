# ChicChat environment variables — copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real secrets.
#
# Phase A (Steps 0–7) runs entirely locally with no external accounts.
# `supabase start` prints these local values; paste them here.

# --- Supabase (local dev) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used by migrations/seed tooling).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Phase B only (do NOT fill until Phase B; left blank intentionally) ---
# WhatsApp Business / Meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Store connectors (İkas / Shopify)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# IKAS_CLIENT_ID=
# IKAS_CLIENT_SECRET=
