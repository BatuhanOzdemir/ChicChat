# ChicChat environment variables — copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real secrets.
#
# Steps 0–6 run entirely locally with no external accounts; `supabase start`
# prints the local values below. For a deployment see docs/DEPLOYMENT.md.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection — the app, migrations and seed all use this.
# REQUIRED everywhere. Hosted: the Supabase pooler URI (port 6543) with
# `?sslmode=require`, since serverless functions open many short-lived
# connections.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- WhatsApp Cloud API (Meta) — Phase B, Step 8 ---
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Self-chosen string; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# Required for production webhooks; only local development may omit it.
WHATSAPP_APP_SECRET=

# --- Store connectors (İkas / Shopify) — Phase B, Step 9 ---
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# IKAS_CLIENT_ID=
# IKAS_CLIENT_SECRET=

# --- Simulator (SPEC §7) ---
# The chat simulator is always available outside production. In a production
# build set this to `true` to expose it (e.g. for the sales demo) — it sits
# behind named console accounts, and it writes cases using simulated delivery.
SIMULATOR_ENABLED=

# --- Deployment (Step 7) ---
# Production always requires a named account. Provision with scripts/console-user.mjs.
# Set true to exercise authentication during local development too.
CONSOLE_AUTH_REQUIRED=
# CONSOLE_PASSCODE is retired; existing shared-passcode cookies are not accepted.
# Lets the inactivity job (SPEC §11) be triggered on a schedule. Vercel Cron
# sends CRON_SECRET automatically; MAINTENANCE_SECRET is for calling it by hand:
#   curl -X POST -H "Authorization: Bearer $MAINTENANCE_SECRET" \
#        https://<host>/api/maintenance/sessions
MAINTENANCE_SECRET=
# CRON_SECRET=
