# ChicChat environment variables (docs/DEPLOYMENT.md §3).
#
# The app reads plain environment variables and never loads a .env file
# itself. Locally, keep your values in a gitignored file such as .env.local
# and load them into your shell, for example:
#   set -a; . ./.env.local; set +a
# On Vercel, enter them under Project → Settings → Environment Variables.
# NEVER commit real secrets.

# --- Mode ---
# Leave unset in every deployment: unset means production (login required,
# webhook signatures mandatory). Set to `development` only on your machine.
# CHICCHAT_ENV=development

# --- Database (required everywhere) ---
# Local: the Docker database from the README. Hosted: the Supabase
# transaction-mode pooler URI (port 6543) with `?sslmode=require`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chicchat
# Connections per process/instance (default 10; use a small value on Vercel).
# DATABASE_POOL_SIZE=10

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Self-chosen string; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# Required for production webhooks; only local development may omit it.
WHATSAPP_APP_SECRET=

# --- Simulator (SPEC §7) ---
# Always available in development. In production set `true` to expose it
# behind named console accounts.
SIMULATOR_ENABLED=

# --- Console accounts ---
# Production always requires a named account (python -m
# chicchat.scripts.console_user). Set true to test login during development.
CONSOLE_AUTH_REQUIRED=

# --- Maintenance job (SPEC §11) ---
# Bearer secret for /api/maintenance/sessions; the GitHub workflow sends it.
MAINTENANCE_SECRET=
# CRON_SECRET=

# --- Running outside Vercel (python -m chicchat.web) ---
# HOST=127.0.0.1
# PORT=8000
# WEB_CONCURRENCY=1
# FORWARDED_ALLOW_IPS=127.0.0.1
