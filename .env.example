# ChicChat environment variables — copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real secrets.
#
# Phase A (Steps 0–7) runs entirely locally with no external accounts.
# `supabase start` prints these local values; paste them here.

# --- Supabase (local dev) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used by migrations/seed tooling).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- WhatsApp Cloud API (Meta) — Phase B, Step 8 ---
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Self-chosen string; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# Optional: enables X-Hub-Signature-256 verification of inbound webhooks.
WHATSAPP_APP_SECRET=

# --- Store connectors (İkas / Shopify) — Phase B, Step 9 ---
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# IKAS_CLIENT_ID=
# IKAS_CLIENT_SECRET=
